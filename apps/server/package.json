{
  "name": "cadence-server",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted server for Cadence: accounts, OIDC sign-in, music library and streaming.",
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning --test \"dist/**/*.test.js\"",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "music-metadata": "12.2.3"
  },
  "devDependencies": {
    "@eslint/js": "9.11.1",
    "@types/node": "22.10.2",
    "eslint": "9.11.1",
    "globals": "15.9.0",
    "typescript": "5.5.4",
    "typescript-eslint": "8.8.0"
  }
}
