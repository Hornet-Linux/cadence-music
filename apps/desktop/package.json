{
  "name": "cadence",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A self-hostable, plugin-extensible desktop music player.",
  "author": "Hornet-Linux",
  "engines": {
    "node": ">=20"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "dev:web": "vite --mode web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node e2e/smoke.mjs",
    "preview": "vite preview",
    "electron:build:win": "tsc --noEmit && vite build && electron-builder --win --publish never",
    "electron:build:mac": "tsc --noEmit && vite build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "net.hornetlinux.cadencemusic",
    "productName": "Cadence",
    "electronVersion": "42.11.0+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/vmp-sign.cjs",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "Cadence-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Cadence"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Cadence-Setup.exe",
      "shortcutName": "Cadence"
    }
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "react": "18.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "https://github.com/castlabs/electron-releases#v42.11.0+wvcus",
    "electron-builder": "24.13.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.55.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-electron": "0.28.8",
    "vite-plugin-electron-renderer": "0.14.6",
    "vitest": "5.0.5"
  }
}
