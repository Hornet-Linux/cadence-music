{
  "name": "unnamed-music-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A self-hostable, plugin-extensible desktop music player.",
  "author": "Hornet-Linux",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "electron:build:win": "tsc --noEmit && vite build && electron-builder --win"
  },
  "build": {
    "appId": "net.hornetlinux.unnamedmusicapp",
    "productName": "Unnamed Music App",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.11.1",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "2.1.1",
    "electron": "31.3.1",
    "electron-builder": "24.13.3",
    "eslint": "9.11.1",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.9.0",
    "jsdom": "25.0.1",
    "typescript": "5.5.4",
    "typescript-eslint": "8.8.0",
    "vite": "5.4.8",
    "vite-plugin-electron": "0.28.8",
    "vite-plugin-electron-renderer": "0.14.6",
    "vitest": "2.1.1"
  }
}
