# Add a site block like this to your Caddyfile. Caddy obtains and renews the
# TLS certificate automatically once the domain's DNS points at this server.
#
# If Caddy runs in Docker with `network_mode: host`, 127.0.0.1 reaches the
# music server directly. If Caddy runs on a Docker network instead, put both
# containers on the same network and use `reverse_proxy server:8787`.

# reverse_proxy sends the real client address in X-Forwarded-For (replacing any
# value the client sent), which is what the server's default TRUST_PROXY (a proxy on this machine or a private network) reads.

music.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787
}
