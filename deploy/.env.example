# ---- Where things live (read by docker compose) ---------------------------
# Folder on the host that holds your music. Mounted read-only.
MUSIC_PATH=./music
# Host port bound on 127.0.0.1 for your reverse proxy to reach.
HOST_PORT=8787

# ---- Server ----------------------------------------------------------------
# The public address of this server. Required for OIDC.
PUBLIC_URL=https://music.example.com
# Rescan the music folder every N minutes (0 = only at start-up / on demand).
SCAN_INTERVAL_MINUTES=60
LOG_LEVEL=info

# ---- Local admin account (optional) -------------------------------------------
# Created on first start if it doesn't exist. Useful as a break-glass login
# even when you use OIDC. Remove the password from this file afterwards if
# you like; the account keeps it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# ---- OIDC single sign-on (optional, e.g. Authentik) -------------------------
# Redirect URI to register with your provider:
#   https://music.example.com/api/auth/oidc/callback
# OIDC_ISSUER=https://auth.example.com/application/o/unnamed-music/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Label for the sign-in button in the app.
# OIDC_NAME=Authentik
# OIDC_SCOPES=openid profile email
# Only members of these groups may sign in (comma-separated; empty = anyone
# your provider lets through).
# OIDC_ALLOWED_GROUPS=
# Members of these groups become server admins.
# OIDC_ADMIN_GROUPS=
