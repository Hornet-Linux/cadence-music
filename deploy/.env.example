# ---- Where things live (read by docker compose) ---------------------------
# Folder on the host that holds your music. Mounted read-only.
MUSIC_PATH=./music
# Host port bound on 127.0.0.1 for your reverse proxy to reach.
HOST_PORT=8787

# ---- Server ----------------------------------------------------------------
# The public address of this server. Required for OIDC.
PUBLIC_URL=https://music.example.com
# Rescan the music folder every N minutes (0 = only at start-up / on demand).
SCAN_INTERVAL_MINUTES=60
LOG_LEVEL=info
# How many reverse proxies sit in front of the server (the bundled Caddy, nginx,
# Traefik...). The server believes that many hops of X-Forwarded-For when it
# rate limits sign-ins. 1 is right for a single proxy. Use false if clients
# connect directly, or a list of proxy IPs/CIDRs (e.g. 172.18.0.0/16).
# TRUST_PROXY=1

# ---- Local admin account (optional) -------------------------------------------
# Created on first start if it doesn't exist. Useful as a break-glass login
# even when you use OIDC. Remove the password from this file afterwards if
# you like; the account keeps it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# ---- OIDC single sign-on (optional, e.g. Authentik) -------------------------
# Redirect URI to register with your provider:
#   https://music.example.com/api/auth/oidc/callback
# OIDC_ISSUER=https://auth.example.com/application/o/cadence/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Label for the sign-in button in the app.
# OIDC_NAME=Authentik
# OIDC_SCOPES=openid profile email
# Only members of these groups may sign in (comma-separated; empty = anyone
# your provider lets through).
# OIDC_ALLOWED_GROUPS=
# Members of these groups become server admins.
# OIDC_ADMIN_GROUPS=

# ---- Spotify (optional) -------------------------------------------------------
# Client ID of your Spotify developer app, offered to every desktop app that
# signs in here so nobody has to paste it. Not a secret. Register the redirect
# URI http://127.0.0.1:43821/callback on that app.
# SPOTIFY_CLIENT_ID=

# ---- Apple Music (optional; needs an Apple Developer Program membership) ------
# From developer.apple.com: Certificates, IDs & Profiles -> Keys -> a key with
# "Media Services (MusicKit)". The private key stays on this server; apps get
# short-lived developer tokens signed with it.
# APPLE_MUSIC_TEAM_ID=
# APPLE_MUSIC_KEY_ID=
# Paste the .p8 contents on one line with \n for line breaks, or mount the file
# and point APPLE_MUSIC_PRIVATE_KEY_FILE at it.
# APPLE_MUSIC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APPLE_MUSIC_PRIVATE_KEY_FILE=/run/secrets/AuthKey.p8

# ---- Sign-up (optional) ---------------------------------------------------------
# Let people create their own accounts at https://<your domain>/ and in the app.
# closed (default) | open | invite. Sign-up is always closed until the owner has
# created the admin with the first-run setup code.
# SIGNUP_MODE=closed
# SIGNUP_INVITE_CODE=
# Download link on the sign-up page (defaults to the GitHub releases page).
# APP_DOWNLOAD_URL=
